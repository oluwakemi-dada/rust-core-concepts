{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch control-flow",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path",
          "${workspaceRoot}/control-flow/Cargo.toml"
        ],
        "filter": {
          "name": "control-flow",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceRoot}/control-flow"
    }
  ]
}
